# ===== LLM（OpenAI 兼容接口，如硅基流动）=====
OPENAI_API_KEY=your_api_key_here
OPENAI_API_BASE=https://api.siliconflow.cn/v1
# 当前部署 Qwen2.5-7B-Instruct（已针对 7B 做工程适配：ReAct 文本协议 + 两阶段选表 + 45s 超时）
# 后期可升级 Qwen2.5-72B-Instruct 提升表格代理代码生成准确率（仅改本行即可，余代码无需动）
OPENAI_API_MODEL=Qwen/Qwen2.5-7B-Instruct
OPENAI_API_EMBEDDING_MODEL=BAAI/bge-m3

# ===== 服务认证 =====
# 多个 key 用英文逗号分隔，便于轮换；为空时认证关闭（仅限本地开发）
API_KEYS=change-me-please

# ===== 可选覆盖（默认值见 app/core/config.py）=====
# TEXT_DATA_DIR=advance/datas/文本数据
# TABLE_DATA_DIR=advance/datas/表数据+表结构说明+表介绍
# TOP_K=6
# SCORE_THRESHOLD=0.35
# RATE_LIMIT_PER_MINUTE=20
# SANDBOX_TIMEOUT_S=30
